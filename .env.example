# ============================================================
# FBM Packing Slip Portal — Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Amazon SP-API ---
AMAZON_CLIENT_ID=your_amazon_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_REFRESH_TOKEN=your_amazon_refresh_token_here
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_MERCHANT_TOKEN=your_merchant_token_here
AMAZON_REGION=us-east-1
AMAZON_ENDPOINT=https://sellingpartnerapi-na.amazon.com

# --- App ---
NEXT_PUBLIC_APP_URL=https://your-domain.com
APP_SECRET=generate_a_random_32char_secret_here
CRON_SECRET=generate_another_random_secret_here
